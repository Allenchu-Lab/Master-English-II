    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tencentcloud-sdk-nodejs-ses": "^4.1.271",
    "uuid": "^11.1.1"
