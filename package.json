    "test:smoke": "node tests/smoke.mjs",
    "test:core": "node tests/core-flow.mjs",
    "test:content": "node tests/content.mjs",
    "build:seed": "node scripts/build-supabase-seed.mjs",
    "build:keys": "node scripts/build-answer-keys.mjs",
    "generate:keys": "node scripts/generate-answer-keys.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "test:regression": "node tests/translation-review.mjs && node tests/review-rubrics.mjs && node tests/review-stream.mjs && node tests/intensive-review-route.mjs && node tests/translation-review-route.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.7",
