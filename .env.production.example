POSTGRES_DB=master_english
POSTGRES_USER=master_english
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://master_english:replace-with-a-long-random-password@db:5432/master_english
OTP_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false
EMAIL_LOGIN_ENABLED=false
# Comma-separated email addresses allowed to open /admin.
ADMIN_EMAILS=

# Template must be approved in the same SES region. Keep secrets server-side.
SES_REGION=ap-hongkong
SES_TEMPLATE_ID=215390
SES_FROM_EMAIL="ChiTouEN II <noreply@mail.chitouen.cn>"
SES_SECRET_ID=
SES_SECRET_KEY=
# Real sending also requires a verified, explicitly enabled database budget. See EMAIL-SETUP.md.

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-account
SMTP_PASS=your-smtp-password
SMTP_FROM=Master English II <your-smtp-account@example.com>

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
