DATABASE_URL=postgresql://master_english:password@127.0.0.1:5432/master_english
OTP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# 登录验证码发信（优先腾讯云 SES，未配置时回退 SMTP）
# SES 配置：开通腾讯云邮件推送 → 验证发信域名(SPF/DKIM) → 创建发信地址 → CAM 子账号授权
SES_SECRET_ID=your-tencent-ses-secret-id
SES_SECRET_KEY=your-tencent-ses-secret-key
SES_REGION=ap-guangzhou
SES_FROM_EMAIL=Master English II <noreply@your-domain.com>

# SMTP 回退配置（可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-account
SMTP_PASS=your-smtp-password
SMTP_FROM=Master English II <your-smtp-account@example.com>

DEEPSEEK_API_KEY=your-deepseek-api-key
