POSTGRES_DB=master_english
POSTGRES_USER=master_english
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://master_english:replace-with-a-long-random-password@db:5432/master_english
OTP_SECRET=replace-with-a-different-long-random-secret
COOKIE_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-account
